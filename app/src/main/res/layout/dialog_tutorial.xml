<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/bg_dark"
    android:padding="16dp">

    <!-- Header bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="🎬 Animated Video &amp; Audio Tutorial"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnMuteAudio"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="🔊 Voice On"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:background="@drawable/bg_card_rounded"
            android:paddingHorizontal="12dp" />
    </LinearLayout>

    <!-- Animated Video Canvas View -->
    <com.aniz.cpubenchmark.AnimatedVideoCanvasView
        android:id="@+id/animatedVideoCanvas"
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:background="@color/surface_dark" />

    <!-- Subtitle / Explanation Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_card_rounded"
        android:padding="12dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/tvSceneTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Scene 1 of 5: Multi-Core Architecture"
            android:textColor="@color/accent_cyan"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvNarrationText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Narration text will appear here..."
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:lineSpacingExtra="3dp" />
    </LinearLayout>

    <!-- Playback Controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="12dp">

        <Button
            android:id="@+id/btnPrevScene"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="⏮ Previous"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:background="@drawable/bg_card_rounded"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnPlayPause"
            android:layout_width="120dp"
            android:layout_height="44dp"
            android:text="⏸ Pause"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="@drawable/bg_button_primary"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnNextScene"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="Next ⏭"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:background="@drawable/bg_card_rounded" />
    </LinearLayout>

    <!-- Direct Scene Jump Chips -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginBottom="8dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/chipScene0"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="1. Multi-Core"
                android:textColor="@color/text_primary"
                android:textSize="11sp"
                android:background="@drawable/bg_card_rounded"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/chipScene1"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="2. Scheduling (R3)"
                android:textColor="@color/text_primary"
                android:textSize="11sp"
                android:background="@drawable/bg_card_rounded"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/chipScene2"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="3. Race Conditions"
                android:textColor="@color/text_primary"
                android:textSize="11sp"
                android:background="@drawable/bg_card_rounded"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/chipScene3"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="4. Amdahl's Law"
                android:textColor="@color/text_primary"
                android:textSize="11sp"
                android:background="@drawable/bg_card_rounded"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/chipScene4"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="5. Function vs Listener"
                android:textColor="@color/text_primary"
                android:textSize="11sp"
                android:background="@drawable/bg_card_rounded" />
        </LinearLayout>
    </HorizontalScrollView>

</LinearLayout>
